#!/bin/bash
# Run by macOS Installer.app after PrintPort.app is copied into /Applications
# (wired in via electron-builder's build.pkg.scripts, see server/package.json).
#
# 1. Launch the app once, hidden, so certManager.ts generates the local CA.
# 2. Import that CA into the login keychain as trusted, so Safari/Chrome
#    accept wss://127.0.0.1:8181 without a manual certificate prompt.

set -e

APP="/Applications/PrintPort.app"
USER_HOME=$(eval echo "~$USER")
CA_PATH="$USER_HOME/Library/Application Support/PrintPort/ca-cert.pem"

open -a "$APP" --args --generate-cert-and-exit
# Give the app a moment to write the cert files before we read them.
for i in $(seq 1 20); do
  [ -f "$CA_PATH" ] && break
  sleep 0.5
done

if [ -f "$CA_PATH" ]; then
  security add-trusted-cert -r trustRoot -k "$USER_HOME/Library/Keychains/login.keychain-db" "$CA_PATH"
else
  echo "PrintPort: certificate file not found after launch, skipping trust import." >&2
fi

exit 0
