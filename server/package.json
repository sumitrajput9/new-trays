{
  "name": "printtrays-server",
  "version": "1.3.44",
  "description": "PrintTrays background bridge — Electron tray app + local WSS server for printer/serial/USB access from the browser.",
  "main": "dist/main.js",
  "homepage": "https://printtrays.example.com",
  "scripts": {
    "dev": "tsc -w -p tsconfig.json & electron dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron dist/main.js",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "node-forge": "^1.3.1",
    "node-hid": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.8.1",
    "pdfjs-dist": "^3.11.174",
    "serialport": "^12.0.0",
    "unix-print": "^1.3.2",
    "usb": "^2.13.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.11",
    "@types/ws": "^8.5.10",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.printtrays.app",
    "productName": "PrintTrays",
    "asar": true,
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "../installers/out"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*",
      "**/node_modules/@napi-rs/canvas*/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "PrintTrays"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "include": "../installers/windows/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "pkg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "entitlements": "../installers/macos/entitlements.mac.plist",
      "entitlementsInherit": "../installers/macos/entitlements.mac.plist"
    },
    "pkg": {
      "scripts": "../installers/macos/pkg-scripts",
      "installLocation": "/Applications"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "printtrays",
      "desktop": {
        "Name": "PrintTrays",
        "Comment": "Local print bridge for web apps"
      }
    },
    "deb": {
      "afterInstall": "../installers/linux/postinst.sh"
    }
  },
  "author": {
    "name": "PrintTrays",
    "email": "support@printtrays.example.com"
  },
  "license": "UNLICENSED"
}
